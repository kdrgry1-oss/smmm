# deploy/.env olarak KOPYALA ve TÜM değerleri değiştir. Bu dosyayı asla git'e koyma.
DOMAIN=uygulamam.com
# Alan adı + TLS varken https (varsayılan). IP üzerinden test modunda http yap.
# Bu değer Caddy site adresini, CORS'u ve web'in API adresini birlikte yönetir.
PUBLIC_SCHEME=https

DB_USER=malimusavir
# En az 24 karakter rastgele: openssl rand -base64 24
DB_PASSWORD=DEGISTIR_guclu_db_sifresi

# En az 32 karakter rastgele: openssl rand -base64 48
JWT_KEY=DEGISTIR_en_az_32_karakter_rastgele_jwt_anahtari

# TAM 32 karakter olmalı (AES-256): openssl rand -hex 16
AES_KEY=DEGISTIR_tam_32_karakterlik_anah

SUPERADMIN_EMAIL=admin@uygulamam.com
SUPERADMIN_PASSWORD=DEGISTIR_guclu_admin_sifresi

# GİB Portal Robotu (entegratör kullanmayan mükellefler için gelen belge + e-Tebligat çekimi).
# api ve gib-robot servisleri bu SIRRI PAYLAŞIR; robot yalnız iç ağdadır, dışarıya açılmaz.
# Üretim değeri üretmek için: openssl rand -hex 32
ROBOT_TOKEN=DEGISTIR_openssl_rand_hex_32_ciktisi

# Anahtarlar geldikçe doldur; boşken Mock çalışır
# OCR_PROVIDER: Mock | LlmVision (Anthropic) | OpenAi (GPT-4o mini) | Gemini (Google 2.5 Flash)
OCR_PROVIDER=Mock
ANTHROPIC_API_KEY=
# Kademeli OCR (varsayılan kademe: haiku → sonnet). Birincil model ucuz olan;
# WhatsApp sıkıştırması gibi zor görsellerde sonuç zayıfsa fallback model AYNI
# görseli bir kez daha okur. Boş bırakılırsa compose varsayılanları geçerlidir.
ANTHROPIC_MODEL=claude-haiku-4-5
# Fallback'i kapatmak için birincil modelle AYNI değeri yaz (ikinci çağrı yapılmaz).
ANTHROPIC_FALLBACK_MODEL=
# OCR_PROVIDER=OpenAi yapınca kullanılır (OpenAI yalnız görüntü kabul eder, PDF için LlmVision/Gemini)
OPENAI_API_KEY=
# OCR_PROVIDER=Gemini yapınca kullanılır (Google AI Studio anahtarı; görüntü VE PDF okur,
# kademeli okuma: gemini-2.5-flash → zayıf sonuçta gemini-2.5-pro ile bir kez daha)
GEMINI_API_KEY=
# Fiş görseli depolama sıkıştırması. OCR her zaman ORİJİNAL görüntüyle çalışır (okuma
# isabeti için); bu bayrak yalnızca okuma bittikten SONRA diske yazılan kopyanın
# sıkıştırılmasını kontrol eder. false → kalıcı kopya da orijinal kalır (daha fazla disk).
# Önerilen: true
IMAGE_PROCESSING_ENABLED=true
PAYMENTS_PROVIDER=Mock
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Yedekleme (backup.sh) — offsite S3-uyumlu depo (farklı sağlayıcı önerilir)
BACKUP_GPG_PASSPHRASE=DEGISTIR_yedek_sifreleme_parolasi
# rclone remote adı (kurulumu README-DEPLOY'da); boş bırakılırsa yedek sadece yerelde kalır
RCLONE_REMOTE=
