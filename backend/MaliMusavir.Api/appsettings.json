{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=malimusavir;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "MaliMusavirSaaS",
    "Audience": "MaliMusavirSaaS",
    "Key": "CHANGE_ME_super_secret_key_at_least_32_chars_long_123456",
    "ExpiryHours": 12
  },
  "Security": {
    "SecretKey": "CHANGE_ME_32_chars_aes_key_0001!"
  },
  "Storage": {
    "Root": "storage"
  },
  // ImageProcessing: fiş görseli DEPOLAMA sıkıştırması. OCR her zaman ORİJİNAL görüntüyle
  // çalışır; Enabled yalnızca okuma bittikten sonra diske yazılan kopyanın sıkıştırılmasını
  // kontrol eder (false → kalıcı kopya orijinal kalır, daha fazla disk). Önerilen: true.
  "ImageProcessing": {
    "Enabled": true,
    "MaxLongEdge": 1600,
    "JpegQuality": 75
  },
  "Ocr": {
    "Provider": "Mock",
    "Anthropic": {
      "ApiKey": "",
      "Model": "claude-sonnet-4-5",
      "FallbackModel": "claude-sonnet-4-5",
      "FallbackThreshold": 0.5,
      "MaxTokens": 2000
    },
    "OpenAi": {
      "ApiKey": "",
      "Model": "gpt-4o-mini",
      "MaxTokens": 2000
    },
    "Gemini": {
      "ApiKey": "",
      "Model": "gemini-flash-latest",
      "FallbackModel": "gemini-pro-latest",
      "FallbackThreshold": 0.5,
      "MaxTokens": 2000
    }
  },
  "Payments": {
    "Provider": "Mock",
    "Iyzico": {
      "ApiKey": "",
      "SecretKey": "",
      "BaseUrl": "https://sandbox-api.iyzipay.com",
      "CallbackUrl": "http://localhost:3000/panel/ayarlar"
    }
  },
  "SuperAdmin": {
    "Email": "admin@malimusavir.local",
    "Password": "Admin!12345",
    "FullName": "Sistem Yoneticisi"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
